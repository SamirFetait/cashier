# Django
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Leave DATABASE_URL unset for local dev — it defaults to a SQLite file inside the
# backend/ folder (absolute path, so it works regardless of the working directory).
# For the networked/production setup use PostgreSQL, e.g.:
# DATABASE_URL=postgres://cashier:cashier@db:5432/cashier

# CORS — the Electron renderer origin(s) allowed to call the API.
# In dev, electron-vite serves the renderer from http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# WhatsApp sidecar
WHATSAPP_SERVICE_URL=http://localhost:3001
WHATSAPP_SHARED_SECRET=change-me-shared-secret

# Default country code used to normalize phone numbers without a leading + (e.g. 20 = Egypt)
DEFAULT_COUNTRY_CODE=20

# --- Branch identity + HQ (head office) daily reporting ---
# Identify this POS installation (one branch). Must match a Branch registered at HQ.
BRANCH_CODE=BR001
BRANCH_NAME=Downtown Branch
# Central HQ base URL + the API key HQ issued for this branch. Leave HQ_API_URL blank to disable.
HQ_API_URL=http://127.0.0.1:9000
HQ_API_KEY=change-me-branch-key
# Close-of-business time (local TIME_ZONE, 24h HH:MM) when the scheduler sends the daily report.
REPORT_TIME=22:00
