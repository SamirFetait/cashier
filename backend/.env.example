# Django
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Leave DATABASE_URL unset for local dev — it defaults to a SQLite file inside the
# backend/ folder (absolute path, so it works regardless of the working directory).
# For the networked/production setup use PostgreSQL, e.g.:
# DATABASE_URL=postgres://cashier:cashier@db:5432/cashier

# CORS — the Electron renderer origin(s) allowed to call the API.
# In dev, electron-vite serves the renderer from http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# WhatsApp sidecar
WHATSAPP_SERVICE_URL=http://localhost:3001
WHATSAPP_SHARED_SECRET=change-me-shared-secret

# WhatsApp Cloud API (Meta's official API). With the token and the phone number
# ID set, website order alerts go out through it from this server, even with
# every PC at the shop off, instead of through the sidecar. README: "WhatsApp
# order alerts through Meta's Cloud API".
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=
# Needed to create and check the alert templates.
WHATSAPP_CLOUD_WABA_ID=
# Needed only to create the template that carries the transfer screenshot.
WHATSAPP_CLOUD_APP_ID=
# WHATSAPP_CLOUD_API_VERSION=v26.0

# Default country code used to normalize phone numbers without a leading + (e.g. 20 = Egypt)
DEFAULT_COUNTRY_CODE=20

# --- Branch identity + HQ (head office) daily reporting ---
# Identify this POS installation (one branch). Must match a Branch registered at HQ.
BRANCH_CODE=BR001
BRANCH_NAME=Downtown Branch
# Central HQ base URL + the API key HQ issued for this branch. Leave HQ_API_URL blank to disable.
HQ_API_URL=http://127.0.0.1:9000
HQ_API_KEY=change-me-branch-key
# Close-of-business time (local TIME_ZONE, 24h HH:MM) when the scheduler sends the daily report.
REPORT_TIME=22:00

# --- Website (storefront + orders admin, hosted on cPanel) ---
# The two sites' addresses. Both are allowed through CORS automatically, and
# SHOP_SITE_URL is used in the tracking links staff send to customers.
SHOP_SITE_URL=http://localhost:5180
SHOP_ORDERS_URL=http://localhost:5181
# Stock location web orders sell from (blank: the default storage).
SHOP_STORAGE_ID=
# Till whose open shift takes cash from web orders (blank: any open shift).
SHOP_TERMINAL=
SHOP_TIME_ZONE=Africa/Cairo
SHOP_VIDEO_MAX_MB=80
# 1 when the server is reached through Cloudflare Tunnel or another proxy.
SHOP_NUM_PROXIES=0
# Production: add this server's public name, e.g.
# ALLOWED_HOSTS=192.168.1.10,localhost,api.fatheetkheer.com

# --- cPanel (README: "The server on cPanel") ---
# collectstatic's folder for the admin's CSS: the API subdomain's document root.
# STATIC_ROOT=/home/<cpanel-user>/api.fatheetkheer.com/static
