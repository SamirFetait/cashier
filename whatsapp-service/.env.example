# Port the sidecar listens on (Django's WHATSAPP_SERVICE_URL must match)
PORT=3001

# Shared secret — must equal the backend's WHATSAPP_SHARED_SECRET.
# Requests without a matching x-api-key header are rejected.
WHATSAPP_SHARED_SECRET=change-me-shared-secret

# Where the WhatsApp session is persisted (so you only scan the QR once).
SESSION_PATH=./.wwebjs_auth

# Optional: path to a system Chromium/Chrome to avoid Puppeteer's bundled download.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
